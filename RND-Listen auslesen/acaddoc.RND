; Lade RNDlist.LSP, falls es noch nicht geladen ist
(princ "\nLade RNDlist.LSP und führe den Befehl ExtractAttributes aus...")
(if (not (load "RNDlist.lsp" nil))
(princ "\nFehler: Konnte RNDlist.LSP nicht laden.")
)
(c:ExtractAttributes)

; Lade APSlist.LSP, falls es noch nicht geladen ist
